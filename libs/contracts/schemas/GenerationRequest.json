{
  "$defs": {
    "ExternalItem": {
      "additionalProperties": false,
      "description": "One page found on an allowlisted external source. Always shown as unvetted.",
      "properties": {
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "snapshot_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Uri"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "snippet",
        "score"
      ],
      "title": "ExternalItem",
      "type": "object"
    },
    "RetrievedChunk": {
      "additionalProperties": false,
      "description": "A chunk with the score of each retrieval stage that saw it.",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "dense": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense"
        },
        "doc_version": {
          "title": "Doc Version",
          "type": "string"
        },
        "lexical": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lexical"
        },
        "page_end": {
          "title": "Page End",
          "type": "integer"
        },
        "page_start": {
          "title": "Page Start",
          "type": "integer"
        },
        "rerank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "doc_version",
        "page_start",
        "page_end",
        "text"
      ],
      "title": "RetrievedChunk",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contexts": {
      "items": {
        "$ref": "#/$defs/RetrievedChunk"
      },
      "title": "Contexts",
      "type": "array"
    },
    "external_contexts": {
      "items": {
        "$ref": "#/$defs/ExternalItem"
      },
      "title": "External Contexts",
      "type": "array"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "question",
    "contexts",
    "model_version",
    "prompt_version"
  ],
  "title": "GenerationRequest",
  "type": "object"
}
