{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "Points at a knowledge base chunk, or at an external url for unvetted sources.",
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "doc_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Version"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "Citation",
      "type": "object"
    },
    "ToolCallRecord": {
      "additionalProperties": false,
      "description": "Summary of one tool call, kept with the generated answer.",
      "properties": {
        "duration_ms": {
          "minimum": 0.0,
          "title": "Duration Ms",
          "type": "number"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "tool",
        "operation",
        "verdict",
        "duration_ms"
      ],
      "title": "ToolCallRecord",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "pass",
        "fail",
        "error"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "timings_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings Ms",
      "type": "object"
    },
    "tokens_in": {
      "minimum": 0,
      "title": "Tokens In",
      "type": "integer"
    },
    "tokens_out": {
      "minimum": 0,
      "title": "Tokens Out",
      "type": "integer"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/ToolCallRecord"
      },
      "title": "Tool Calls",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "answer",
    "citations",
    "tokens_in",
    "tokens_out"
  ],
  "title": "GenerationResult",
  "type": "object"
}
