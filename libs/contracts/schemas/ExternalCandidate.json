{
  "$defs": {
    "CandidateOrigin": {
      "enum": [
        "answer_time",
        "enrichment"
      ],
      "title": "CandidateOrigin",
      "type": "string"
    },
    "CandidateStatus": {
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "title": "CandidateStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An external find waiting for SME triage before it may enter the knowledge base.",
  "properties": {
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "course_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Course Code"
    },
    "found_by": {
      "$ref": "#/$defs/CandidateOrigin"
    },
    "licence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Licence"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_sha256": {
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CandidateStatus",
      "default": "pending"
    },
    "topic": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topic"
    },
    "url": {
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "url",
    "snapshot_sha256",
    "found_by"
  ],
  "title": "ExternalCandidate",
  "type": "object"
}
