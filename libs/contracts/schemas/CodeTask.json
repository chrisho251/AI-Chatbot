{
  "$defs": {
    "CodeLanguage": {
      "enum": [
        "r",
        "python",
        "excel"
      ],
      "title": "CodeLanguage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Ask W3 to write and run code that solves an exercise, then check the draft answer.",
  "properties": {
    "data_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Uri"
    },
    "expected": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected"
    },
    "language": {
      "$ref": "#/$defs/CodeLanguage"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "language",
    "task"
  ],
  "title": "CodeTask",
  "type": "object"
}
