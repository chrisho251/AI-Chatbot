{
  "$defs": {
    "Chunk": {
      "additionalProperties": false,
      "description": "One retrievable piece of text. The embedding is left out when read back from search.",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "doc_version": {
          "title": "Doc Version",
          "type": "string"
        },
        "embedding": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/RegionKind"
          },
          "title": "Kinds",
          "type": "array"
        },
        "page_end": {
          "minimum": 1,
          "title": "Page End",
          "type": "integer"
        },
        "page_start": {
          "minimum": 1,
          "title": "Page Start",
          "type": "integer"
        },
        "region_ids": {
          "items": {
            "type": "string"
          },
          "title": "Region Ids",
          "type": "array"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "token_count": {
          "minimum": 0,
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "chunk_id",
        "doc_version",
        "page_start",
        "page_end",
        "text",
        "token_count"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "RegionKind": {
      "enum": [
        "text",
        "figure",
        "scan",
        "table",
        "equation",
        "code"
      ],
      "title": "RegionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "All chunks W6 produced for one document version in one ingestion run.",
  "properties": {
    "chunker_version": {
      "title": "Chunker Version",
      "type": "string"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/Chunk"
      },
      "title": "Chunks",
      "type": "array"
    },
    "doc_version": {
      "title": "Doc Version",
      "type": "string"
    },
    "embedding_model": {
      "title": "Embedding Model",
      "type": "string"
    },
    "ingestion_run_id": {
      "title": "Ingestion Run Id",
      "type": "string"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ingestion_run_id",
    "doc_version",
    "embedding_model",
    "chunker_version",
    "chunks"
  ],
  "title": "ChunkSet",
  "type": "object"
}
