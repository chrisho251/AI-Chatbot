{
  "$defs": {
    "EscalationStatus": {
      "enum": [
        "open",
        "external_answered",
        "expert_notified",
        "expert_answered",
        "closed"
      ],
      "title": "EscalationStatus",
      "type": "string"
    },
    "ExternalItem": {
      "additionalProperties": false,
      "description": "One page found on an allowlisted external source. Always shown as unvetted.",
      "properties": {
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "snapshot_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Uri"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "snippet",
        "score"
      ],
      "title": "ExternalItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Created when an answer lands at L3. The question is already pseudonymized.",
  "properties": {
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "answered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answered At"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "context_ids": {
      "items": {
        "type": "string"
      },
      "title": "Context Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expert": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expert"
    },
    "external_results": {
      "items": {
        "$ref": "#/$defs/ExternalItem"
      },
      "title": "External Results",
      "type": "array"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "pseudo_user": {
      "title": "Pseudo User",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EscalationStatus"
    },
    "ticket_id": {
      "title": "Ticket Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "ticket_id",
    "pseudo_user",
    "question",
    "confidence",
    "status",
    "created_at"
  ],
  "title": "EscalationTicket",
  "type": "object"
}
