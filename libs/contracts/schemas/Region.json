{
  "$defs": {
    "RegionKind": {
      "enum": [
        "text",
        "figure",
        "scan",
        "table",
        "equation",
        "code"
      ],
      "title": "RegionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A typed area of one page, produced by W1 layout analysis.",
  "properties": {
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "doc_version": {
      "title": "Doc Version",
      "type": "string"
    },
    "image_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Uri"
    },
    "ingestion_run_id": {
      "title": "Ingestion Run Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RegionKind"
    },
    "page_no": {
      "minimum": 1,
      "title": "Page No",
      "type": "integer"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "raw_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Text"
    },
    "region_id": {
      "title": "Region Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ingestion_run_id",
    "region_id",
    "doc_version",
    "page_no",
    "kind"
  ],
  "title": "Region",
  "type": "object"
}
