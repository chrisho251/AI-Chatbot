{
  "$defs": {
    "RetrievedChunk": {
      "additionalProperties": false,
      "description": "A chunk with the score of each retrieval stage that saw it.",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "dense": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense"
        },
        "doc_version": {
          "title": "Doc Version",
          "type": "string"
        },
        "lexical": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lexical"
        },
        "page_end": {
          "title": "Page End",
          "type": "integer"
        },
        "page_start": {
          "title": "Page Start",
          "type": "integer"
        },
        "rerank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rerank"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "doc_version",
        "page_start",
        "page_end",
        "text"
      ],
      "title": "RetrievedChunk",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "sufficiency is the top rerank score adjusted by its margin, from 0 to 1.",
  "properties": {
    "chunks": {
      "items": {
        "$ref": "#/$defs/RetrievedChunk"
      },
      "title": "Chunks",
      "type": "array"
    },
    "producer": {
      "default": "unknown",
      "title": "Producer",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sufficiency": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Sufficiency",
      "type": "number"
    },
    "timings_ms": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings Ms",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "chunks",
    "sufficiency"
  ],
  "title": "RetrievalResult",
  "type": "object"
}
