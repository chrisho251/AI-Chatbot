{
  "uid": "chatbot-safety",
  "title": "Safety and misuse (Appendix B.2)",
  "description": "Prompt injection and misuse detections. Details for reviewers are in obs.guard_events, without student identities.",
  "tags": [
    "ai-chatbot"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Detections by category",
      "description": "Guard detections per minute by category.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (category) (rate(chatbot_guard_events_total[5m])) * 60",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Detections by stage",
      "description": "Gateway on questions, W5 on uploads, web pages and sources. Last 24 hours.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (increase(chatbot_guard_events_total[24h]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Blocked questions, 24 hours",
      "description": "Questions refused by the gateway guard.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(chatbot_requests_total{level=\"blocked\"}[24h]))",
          "legendFormat": "blocked"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Actions taken, 24 hours",
      "description": "What happened after a detection, for example block, drop or quarantine.",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (action) (increase(chatbot_guard_events_total[24h]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Detectors, 24 hours",
      "description": "Detections per detector model.",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (detector) (increase(chatbot_guard_events_total[24h]))",
          "legendFormat": "{{detector}}"
        }
      ]
    }
  ]
}
