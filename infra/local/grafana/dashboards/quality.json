{
  "uid": "chatbot-quality",
  "title": "Quality and escalation (Appendix A.6 and C.2)",
  "description": "RAGAs scores, escalation rate, external and expert response times, and knowledge base status.",
  "tags": [
    "ai-chatbot"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "RAGAs, latest golden set run",
      "description": "Mean score per metric of the latest golden set run, with its knowledge base version.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "platform"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "platform"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (metric) metric, mean_score, kb_version, model_version, ts\nFROM reporting.ragas_summary\nWHERE dataset = 'golden'\nORDER BY metric, ts DESC"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAGAs trend",
      "description": "Golden set scores over time, one line per metric.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "platform"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "platform"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT ts AS time, metric, mean_score\nFROM reporting.ragas_summary\nWHERE dataset = 'golden' AND $__timeFilter(ts)\nORDER BY ts"
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Questions per day by level",
      "description": "From ops.interactions through reporting.requests_daily.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "platform"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "platform"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT day AS time, l1, l2, l3\nFROM reporting.requests_daily\nWHERE $__timeFilter(day)\nORDER BY day"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Escalation rate per day",
      "description": "Escalated questions divided by all questions, Appendix C.2.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "platform"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "platform"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT day AS time, escalated::float / nullif(requests, 0) AS escalation_rate\nFROM reporting.requests_daily\nWHERE $__timeFilter(day)\nORDER BY day"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "External and expert response time",
      "description": "Daily p50 and p95. External is escalation start to external answer, expert is ticket to answer.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "platform"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "platform"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT day AS time, external_p50_s, external_p95_s, expert_p50_s, expert_p95_s\nFROM reporting.escalation_daily\nWHERE $__timeFilter(day)\nORDER BY day"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Escalations, last hour",
      "description": "Live count by stage, external search first, then expert.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (increase(chatbot_escalations_total[1h]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Tool calls by verdict",
      "description": "W3 code and W4 math calls from W8 in the last hour.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tool, verdict) (increase(chatbot_tool_calls_total[1h]))",
          "legendFormat": "{{tool}} {{verdict}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Knowledge base status",
      "description": "Serving and candidate versions, pending documents and gate reports waiting for an SME.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "platform"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "platform"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT * FROM reporting.kb_status"
        }
      ]
    }
  ]
}
