# Copy to .env and adjust. Values below work on the host with the data profile running
# Containers override the host names in compose.yaml

# Data platform
PLATFORM_DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot
PLATFORM_OBJECT_STORE=s3
PLATFORM_S3_ENDPOINT_URL=http://localhost:8333
PLATFORM_S3_ACCESS_KEY=chatbot
PLATFORM_S3_SECRET_KEY=chatbot-secret
PLATFORM_EMBEDDING_DIM=1024

# Postgres tests with the integration marker. This database is wiped by the tests
PLATFORM_TEST_DATABASE_URL=postgresql+psycopg://chatbot:chatbot@localhost:5432/chatbot_test

# Model serving, OpenAI compatible LLM and TEI
CHATBOT_LLM_BASE_URL=http://localhost:8080/v1
CHATBOT_LLM_MODEL=qwen3-4b-instruct
CHATBOT_EMBED_BASE_URL=http://localhost:8081
CHATBOT_RERANK_BASE_URL=http://localhost:8082

# Models downloaded by the cpu and gpu profiles. Pin exact revisions at M1
LLM_GGUF_REPO=Qwen/Qwen3-4B-GGUF
LLM_MODEL_REPO=Qwen/Qwen3-4B
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Keys for pseudonyms and text encryption, never commit the key file
CHATBOT_KEY_FILE=infra/local/keys/keys.json

# Traces, leave empty unless the traces profile runs
CHATBOT_OTEL_ENDPOINT=

# Every component runs inside the api process by default. To run one in its own container,
# set CHATBOT_ plus the service name plus _URL, for example CHATBOT_W2_VISION_URL

# Gateway
GATEWAY_OIDC_ISSUER=http://localhost:8180/realms/chatbot
